# ── Existing ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# Upstash Redis (bookings + consult leads). Falls back to in-memory in dev.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# SMTP for booking notifications + Gmail confirmation/ICS (Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=          # where booking notifications go (defaults to SMTP_USER)
CONTACT_EMAIL=         # where /api/contact messages go

# ── Booking → Google Calendar ─────────────────────────────────────────────────
# Option A (no creds): native Google "Appointment schedule" public link, embedded on /book.
NEXT_PUBLIC_BOOKING_URL=
# Option B (OAuth API): create events directly on your calendar.
#   Visit /api/google/connect once to mint GOOGLE_OAUTH_REFRESH_TOKEN.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# ── AI Consulting Agent (Python service) ──────────────────────────────────────
# URL of the deployed agent-service (Railway/Render), or http://localhost:8000 in dev.
AGENT_SERVICE_URL=http://localhost:8000
# Shared secret — must match SERVICE_API_KEY in the agent-service.
AGENT_SERVICE_KEY=change-me

# ── Admin dashboard (/leads) ──────────────────────────────────────────────────
# Required to view consultation leads. Pick a long random string.
ADMIN_KEY=change-me-too
