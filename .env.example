# ── Existing ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# Upstash Redis (bookings + consult leads). Falls back to in-memory in dev.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# SMTP for booking notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=

# ── AI Consulting Agent (Python service) ──────────────────────────────────────
# URL of the deployed agent-service (Railway/Render), or http://localhost:8000 in dev.
AGENT_SERVICE_URL=http://localhost:8000
# Shared secret — must match SERVICE_API_KEY in the agent-service.
AGENT_SERVICE_KEY=change-me

# ── Admin dashboard (/leads) ──────────────────────────────────────────────────
# Required to view consultation leads. Pick a long random string.
ADMIN_KEY=change-me-too
