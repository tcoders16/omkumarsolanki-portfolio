# Colang flows for the consulting assistant.
# Input/output self-check rails wrap our own multi-agent generation.

define flow self check input
  $allowed = execute self_check_input
  if not $allowed
    bot refuse off topic
    stop

define flow self check output
  $allowed = execute self_check_output
  if not $allowed
    bot refuse unsafe output
    stop

define bot refuse off topic
  "I can only help with questions about Om's work and how he'd solve an AI/automation problem for your business. For anything else, email emailtosolankiom@gmail.com."

define bot refuse unsafe output
  "Let's keep this focused on your business problem and how Om can help. Book a free strategy call and we'll dig into specifics: https://cal.com/om-solanki/consultation"

# Catch-all: route every in-scope user message through our LangGraph agents.
define flow consulting
  user ...
  $answer = execute generate_answer
  bot $answer
