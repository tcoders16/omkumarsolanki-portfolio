# --- Required ---
OPENAI_API_KEY=sk-...

# --- Service security (shared secret with the Next.js proxy) ---
SERVICE_API_KEY=change-me
ALLOWED_ORIGINS=http://localhost:3000

# --- Models (sensible defaults) ---
MODEL_FAST=gpt-4o-mini
MODEL_SMART=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# --- Retrieval: vector | vectorless | hybrid ---
RAG_MODE=hybrid
CASE_MATCH_THRESHOLD=0.45

# --- Guardrails ---
GUARDRAILS_ENABLED=true

# --- Knowledge base (defaults work in Docker; synced from the site) ---
KNOWLEDGE_DIR=knowledge
META_FILE=knowledge/om-meta.json
CHROMA_DIR=.chroma

# --- Owner identity (appointment + email agents) ---
OWNER_NAME=Omkumar Solanki
OWNER_EMAIL=emailtosolankiom@gmail.com
OWNER_TIMEZONE=America/Toronto

# --- Email follow-up agent (Resend). Empty key = draft-only mode. ---
RESEND_API_KEY=
RESEND_FROM=Omkumar Solanki <hello@omkumarsolanki.com>
RESEND_REPLY_TO=

# --- Appointment agent (Google Calendar). Empty = booking-link fallback. ---
# Option 1: service account — path to the key JSON file, OR the raw JSON itself
# (good for Azure). Not available if org policy blocks key creation.
GOOGLE_CREDENTIALS_JSON=
# Option 2: OAuth as the calendar owner — same three values the Next.js /book
# page uses (see portfolio .env.local). Used when option 1 is empty.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
APPOINTMENT_DURATION_MIN=30
APPOINTMENT_WINDOW_DAYS=10
APPOINTMENT_HOUR_START=10
APPOINTMENT_HOUR_END=17
